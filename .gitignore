# ============================================================
# .gitignore
# Keeps generated/large/environment-specific files out of Git.
# ============================================================

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# MLflow local tracking data (regenerated every run - not source code)
mlruns/
mlartifacts/

# Trained model artifacts (regenerated by src/train.py)
model/*.keras
model/*.pkl
model/*.json

# Evidently monitoring reports (regenerated by monitoring/monitor.py)
monitoring/*.html

# Data (regenerated / can be large - keep repo lightweight)
# NOTE: for this small academic project we DO track the small
# reference/current CSVs used for monitoring demos, so we do NOT
# ignore data/*.csv. Only ignore heavier caches below.
data/*.cache

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Env variables
.env
